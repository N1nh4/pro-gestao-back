# ── App ──────────────────────────────────────────────────────────
APP_NAME="SAC Pró-Gestão RPPS"
ENVIRONMENT=development
DEBUG=true

# ── Banco de dados ───────────────────────────────────────────────
# PostgreSQL (produção/local via Docker)
DATABASE_URL=postgresql+psycopg://sac_progestao:sac_progestao@localhost:5432/sac_progestao
# Alternativa rápida sem Postgres instalado:
# DATABASE_URL=sqlite:///./sac_progestao.db
SQL_ECHO=false

# ── Segurança / JWT ──────────────────────────────────────────────
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Redis (opcional por enquanto) ────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Arquivos enviados ────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
